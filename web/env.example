# --- Admin (Next → Express; Mongo só no backend) ---
# Obrigatório para /api/admin/* : URL do Express (só servidor — não uses NEXT_PUBLIC_* para admin)
BACKEND_API_URL=https://seu-api.railway.app

# Cliente app (opcional) — bookings/reservas; não substitui BACKEND_API_URL no proxy admin
# NEXT_PUBLIC_API_URL=https://seu-api.railway.app

# Segredo: Next envia header "x-admin-secret" (Express aceita também X-Fitlife-Admin-Secret)
ADMIN_API_SECRET=coloca_um_segredo_longo_igual_no_express

# Não é necessário MONGODB_URI no Next para /admin/clientes
# MONGODB_URI=
